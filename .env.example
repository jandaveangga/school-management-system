# Database
DATABASE_URL="file:./dev.db"

# Server
NODE_ENV="development"
PORT=3001

# JWT — generate strong random secrets (≥32 chars each, must differ)
JWT_ACCESS_SECRET="your-super-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="your-super-refresh-secret-at-least-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
